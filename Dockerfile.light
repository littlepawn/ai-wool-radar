# 轻量版镜像：单容器、Python 标准库、无外部依赖。
# 基于 alpine + tzdata（检查器解析北京时间截止日需要时区数据），
# 不复制 assets/（轻量版生成器不需要它，缺失也不会导致构建失败），
# 不改动仓库根目录的 index.html，生成产物只写容器内的 dist/。
FROM python:3.12-alpine
WORKDIR /app
COPY app/ ./app/
COPY data/ ./data/
RUN apk add --no-cache tzdata \
    && adduser -D appuser \
    && mkdir -p /app/dist /app/state \
    && chown -R appuser:appuser /app
USER appuser
EXPOSE 8080
CMD ["python", "app/light.py"]
