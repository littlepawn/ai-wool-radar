# 复制为 .env 后，把 REPLACE_ME 换成你自己的值。不要把真实 .env 提交到 Git。
# 推送开关：留空即不启用对应渠道。先用 --dry-run 验证，再开启真实推送。

# Bark（iOS）：BARK_URL 二选一；或用 BARK_SERVER + BARK_KEY
BARK_URL=https://api.day.app/REPLACE_WITH_YOUR_BARK_KEY
# BARK_SERVER=https://api.day.app
# BARK_KEY=REPLACE_ME

# Server酱 Turbo
SCT_SENDKEY=REPLACE_ME

# PushPlus
PUSHPLUS_TOKEN=REPLACE_ME

# 企业微信群机器人
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE_ME

# 钉钉群机器人（带签名）
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=REPLACE_ME
DINGTALK_SECRET=REPLACE_ME

# 飞书群机器人（带签名）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME
FEISHU_SECRET=REPLACE_ME

# Telegram Bot（机器人 Token + 聊天 ID，不用在聊天里贴 Token）
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# ntfy（自建或 ntfy.sh 话题地址）
NTFY_URL=https://ntfy.sh/REPLACE_WITH_YOUR_TOPIC
# NTFY_TOKEN=REPLACE_ME

# Gotify
GOTIFY_URL=http://localhost:80
GOTIFY_TOKEN=REPLACE_ME

# Discord / Slack Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_ME

# 邮件 SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM=REPLACE_ME
SMTP_TO=REPLACE_ME

# 通用 Webhook
WEBHOOK_URL=https://example.com/hook
# WEBHOOK_TOKEN=REPLACE_ME

# WxPusher（多个 UID 用英文逗号分隔）
WXPUSHER_APP_TOKEN=REPLACE_ME
WXPUSHER_UIDS=REPLACE_ME

# PushDeer
PUSHDEER_KEY=REPLACE_ME
# PUSHDEER_SERVER=https://api2.pushdeer.com

# 检查器：1 = 只演练，不写状态、不推送
NOTIFY_DRY_RUN=0

# AI 评估（可选，不配也能跑，只走启发式评分）
# AI_API_KEY 留空即禁用 AI；配了 Key 还必须配 AI_MODEL 才启用。
# AI_BASE_URL 默认 https://api.openai.com/v1，兼容 OpenAI 格式的第三方地址也可填。
# AI_API_KEY=REPLACE_ME
# AI_MODEL=REPLACE_ME
# AI_BASE_URL=https://api.openai.com/v1
